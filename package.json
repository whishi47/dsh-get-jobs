{
  "name": "dsh-get-jobs",
  "version": "0.1.0",
  "private": false,
  "description": "求职投递自动化插件（Boss / 猎聘 / 51job / 智联）：一键启动后端、原生管理面板、岗位数据导出与简历驱动的 AI 配置。DeepSeek Harness 插件。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "get-jobs",
    "job-search",
    "boss",
    "liepin"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "mattan",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:node": "node scripts/build.mjs --node",
    "build:client": "node scripts/build.mjs --client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gates": "node scripts/gates.mjs",
    "test": "node test/node.mjs && node test/client.mjs",
    "check": "npm run build && npm run gates && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.2"
  }
}
