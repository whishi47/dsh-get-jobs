{
  "name": "dsh-get-jobs",
  "version": "0.12.0",
  "private": false,
  "description": "投简历还在手动点「打招呼」？把 Boss直聘 / 猎聘 / 51job / 智联 的岗位筛选、AI 打招呼、自动投递与记录导出，做进 DeepSeek Harness 的一个可视化面板。一条命令装好，不用装数据库、不用编译、不用手动起后端。禁止商用。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "get-jobs",
    "job-search",
    "boss",
    "liepin"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "mattan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whishi47/dsh-get-jobs.git"
  },
  "homepage": "https://github.com/whishi47/dsh-get-jobs#readme",
  "bugs": {
    "url": "https://github.com/whishi47/dsh-get-jobs/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "assets/logo.png",
    "assets/favicon.png",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "build": "node scripts/build.mjs",
    "build:node": "node scripts/build.mjs --node",
    "build:client": "node scripts/build.mjs --client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gates": "node scripts/gates.mjs",
    "test": "node test/node.mjs && node test/client.mjs",
    "check": "npm run build && npm run gates && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.2"
  }
}
