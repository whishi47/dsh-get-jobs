node_modules/
*.log

# lib/ 为随仓库发布的预构建产物（公开安装必需），仅排除构建期的临时文件
lib/.client.bundle.cjs

# 本地数据库（含 API_KEY 等敏感配置，绝不入库）
db/
*.db
*.db-shm
*.db-wal

# 项目运行数据 / 缓存
data/
.workbuddy/
dist/
coverage/

# 环境变量与密钥
.env
.env.*
*.local

# 系统文件
.DS_Store
Thumbs.db

# 文档（内部资料，不随仓库发布）
docs/

# 发布资产（jar / db 模板，作为 GitHub Release 资产发布，不入库）
release-assets/
